<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: a launcher entry for the Revolut-style sample (prototype/rv), to see its glass blur on a phone. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <activity
            android:name=".prototype.rv.RvPreviewActivity"
            android:exported="true"
            android:label="@string/rv_preview_label">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
