<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!-- Debug builds only: a launcher entry for the Revolut-style sample (prototype/rv), to see its glass blur on a
             phone. -->
        <activity
            android:name=".prototype.rv.RvPreviewActivity"
            android:exported="true"
            android:label="@string/rv_preview_label">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Debug builds only: adb's hooks for measurements, the core-failure check and the report export
             (vpn/DebugHooks.kt). Only the shell and the system hold DUMP, so no other app can send these. -->
        <receiver
            android:name=".vpn.DebugHooks"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="dev.doona.android.debug.MTU" />
                <action android:name="dev.doona.android.debug.FAULT" />
                <action android:name="dev.doona.android.debug.EXPORT" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
