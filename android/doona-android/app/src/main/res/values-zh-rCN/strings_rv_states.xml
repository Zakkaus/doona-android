<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="rv_welcome_title">欢迎使用 doona</string>
    <string name="rv_welcome_line">doona 是 honk 的 Android 客户端，可直接导入 Clash、sing-box 订阅和分享链接。</string>
    <string name="rv_welcome_core">自研 honk 内核</string>
    <string name="rv_welcome_core_sub">用 Rust 编写，与 Linux 版 honk 同一套内核和配置</string>
    <string name="rv_welcome_split">TCP 和 UDP 可分开选节点</string>
    <string name="rv_welcome_split_sub">默认一起选，需要时让 UDP 走另一个节点</string>
    <string name="rv_welcome_score">综合评分</string>
    <string name="rv_welcome_score_sub">根据实际连接的结果持续评分，自动挑选最好的节点</string>
    <string name="rv_welcome_fast">高性能</string>
    <string name="rv_welcome_fast_sub">内核单连接实测超过 20 Gbps（桌面测试）</string>
    <string name="rv_no_node">没有可用的节点</string>
    <string name="rv_no_node_reason">所有节点的延迟测试都失败。请确认网络连接，或更新订阅后重新测试。</string>
    <string name="rv_retest">重新测试</string>
    <string name="rv_core_stopped">连接已断开</string>
    <string name="rv_core_stopped_reason">doona 的核心已停止运行，流量不再经由节点。</string>
    <string name="rv_crash">doona 先前发生崩溃</string>
    <string name="rv_crash_reason">崩溃记录已保存，会附在诊断报告中。</string>
    <string name="rv_crash_export">导出报告</string>
    <string name="rv_failed_switch_mode">无法切换模式</string>
    <string name="rv_failed_switch_node">无法切换节点</string>
    <string name="rv_failed_test_latency">无法测试延迟</string>
    <string name="rv_lan_ask_title">允许访问局域网</string>
    <string name="rv_lan_ask_body">访问局域网中的订阅与节点需要此权限。</string>
    <string name="rv_lan_ask_continue">继续</string>
    <string name="rv_lan_ask_not_now">暂不</string>
    <string name="rv_lan_denied_title">未允许访问局域网</string>
    <string name="rv_lan_denied_body">无法访问局域网中的订阅与节点。请在应用设置中允许 doona 访问局域网。</string>
    <string name="rv_lan_open_settings">打开设置</string>
    <string name="rv_perm_vpn_title">允许建立 VPN</string>
    <string name="rv_perm_vpn_body">应用的流量要先进入 doona 的 VPN，才能按规则经由节点或直连。</string>
    <string name="rv_perm_notify_title">允许通知</string>
    <string name="rv_perm_notify_body">通知会显示连接状态和断开连接按钮。连接中断时也会提醒你。</string>
