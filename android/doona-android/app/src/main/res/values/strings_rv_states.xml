    <string name="rv_core_stopped">Disconnected</string>
    <string name="rv_core_stopped_reason">doona\'s core stopped, so traffic no longer goes through a node.</string>
    <string name="rv_crash">doona crashed earlier</string>
    <string name="rv_crash_reason">The crash log is kept and goes into the diagnostic report.</string>
    <string name="rv_crash_export">Export report</string>
