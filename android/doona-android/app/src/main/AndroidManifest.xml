<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SYSTEM_EXEMPTED" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Asked for only after something on the local network failed: a subscription or node on a LAN (ARCH D26). -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />

    <!-- Per-app routing names launchable apps only, so these are the packages doona must see (ARCH D16). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".app.DoonaApplication"
        android:allowBackup="false"
        android:label="@string/app_name"
        android:theme="@style/Theme.Doona">

        <activity
            android:name=".app.MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- The only way in that may connect: not exported, so other apps cannot start a connection. -->
        <activity-alias
            android:name=".app.ConnectEntry"
            android:exported="false"
            android:targetActivity=".app.MainActivity" />

        <!-- systemExempted is allowed for VPN apps; lint only knows the exact-alarm criterion.
             https://developer.android.com/develop/background-work/services/fgs/service-types#system-exempted
             Always-on is declared unsupported until doona protects its own sockets (ARCH D14). -->
        <service
            android:name=".vpn.DoonaVpnService"
            android:exported="false"
            android:foregroundServiceType="systemExempted"
            android:permission="android.permission.BIND_VPN_SERVICE"
            tools:ignore="ForegroundServicePermission">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
            <meta-data
                android:name="android.net.VpnService.SUPPORTS_ALWAYS_ON"
                android:value="false" />
        </service>

        <service
            android:name=".vpn.ToggleTileService"
            android:exported="true"
            android:icon="@drawable/ic_duck"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="true" />
        </service>
    </application>
</manifest>
