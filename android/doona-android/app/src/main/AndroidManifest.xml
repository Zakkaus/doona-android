<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".app.DoonaApplication"
        android:allowBackup="false"
        android:label="@string/app_name"
        android:theme="@style/Theme.Doona">

        <activity
            android:name=".app.MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- The only way in that may connect: not exported, so other apps cannot start a connection. -->
        <activity-alias
            android:name=".app.ConnectEntry"
            android:exported="false"
            android:targetActivity=".app.MainActivity" />
    </application>
</manifest>
