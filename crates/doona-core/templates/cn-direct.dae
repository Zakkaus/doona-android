group {
    Proxy {
        policy: selector
        final: block
    }
    Streaming {
        policy: selector
        final: Proxy
    }
    AI {
        policy: selector
        final: Proxy
    }
}

routing {
    dip(geoip:private) -> direct
    domain(suffix: netflix.com, netflix.net, nflxext.com, nflximg.net, nflxso.net, nflxvideo.net, youtube.com, googlevideo.com, ytimg.com, disneyplus.com, bamgrid.com, dssott.com, max.com, primevideo.com) -> Streaming
    domain(suffix: openai.com, chatgpt.com, oaistatic.com, oaiusercontent.com, anthropic.com, claude.ai) -> AI
    domain(geosite:cn) -> direct
    dip(geoip:cn) -> direct
    fallback: Proxy
}

dns {
    upstream {
        alidns: 'https://223.5.5.5/dns-query' -> direct
        google: 'https://8.8.8.8/dns-query' -> Proxy
    }
    routing {
        request {
            qname(geosite:cn) -> alidns
            fallback: google
        }
    }
}
