node {
    n1: 'socks5://10.10.5.1:1080'
    n2: 'socks5://10.10.5.2:1080'
}
group {
    to-direct {
        filter: name('n1', 'n2')
        policy: fallback
        final: direct
    }
    to-block {
        filter: name('n1', 'n2')
        policy: min_moving_avg
        final: block
    }
}
routing {
    domain(suffix: direct.test) -> to-direct
    domain(suffix: block.test) -> to-block
    domain(suffix: refused.test) -> block
    dip(geoip:cn) -> direct(must)
    fallback: direct
}
