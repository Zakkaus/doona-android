node {
    n1: 'socks5://10.10.10.1:1080'
    n2: 'socks5://10.10.10.2:1080'
}
group {
    empty {
        filter: name('absent')
        policy: select
    }
    dead-select {
        filter: name('n1', 'n2')
        policy: select
    }
    dead-auto {
        filter: name('n1', 'n2')
        policy: min_moving_avg
    }
}
routing {
    domain(suffix: empty.test) -> empty
    domain(suffix: select.test) -> dead-select
    domain(suffix: auto.test) -> dead-auto
    fallback: direct
}
