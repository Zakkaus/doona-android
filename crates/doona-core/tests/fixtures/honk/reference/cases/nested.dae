node {
    hk-1: 'socks5://10.10.1.1:1080'
    hk-2: 'socks5://10.10.1.2:1080'
    jp-1: 'socks5://10.10.2.1:1080'
    us-1: 'socks5://10.10.4.1:1080'
}
group {
    hk {
        filter: name(keyword: 'hk')
        policy: min_moving_avg
    }
    jp {
        filter: name(keyword: 'jp')
        policy: fallback
    }
    asia {
        filter: group('hk', 'jp')
        policy: select
        default: 'hk'
    }
    world {
        filter: group('asia')
        filter: name('us-1')
        policy: min_moving_avg
    }
}
routing {
    domain(suffix: asia.test) -> asia
    domain(suffix: world.test) -> world
    fallback: world
}
