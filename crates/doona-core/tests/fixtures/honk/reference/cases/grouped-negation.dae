node {
    n1: 'socks5://10.10.10.1:1080'
    n2: 'socks5://10.10.10.2:1080'
}
group {
    left {
        filter: name('n1')
        policy: select
    }
    right {
        filter: name('n2')
        policy: select
    }
}
routing {
    dport(443) && !domain(suffix: a.test, suffix: b.test) -> left
    !dport(443, 80) -> block
    fallback: right
}
